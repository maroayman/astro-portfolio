{
	"name": "starry-saturn",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:tailnet": "bash scripts/dev-tailnet.sh",
		"predev": "bash scripts/images-pull.sh",
		"build": "bash scripts/images-pull.sh && astro build",
		"preview": "astro preview",
		"check": "astro check",
		"check:fix": "astro check --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "astro check && prettier --check .",
		"images": "bash scripts/images.sh",
		"images:pull": "bash scripts/images-pull.sh --force",
		"images:push": "bash scripts/images-push.sh",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.3.8"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"typescript": "^6.0.3"
	}
}
