---
import { experience } from '../data/portfolio';

interface Props {
	limit?: number;
}

const { limit } = Astro.props;
const items = typeof limit === 'number' ? experience.slice(0, limit) : experience;
---

<ol class="track">
	{items.map((job, i) => (
		<li class="entry reveal" style={`--reveal-delay:${i * 70}ms`}>
			<div class="entry__rail" aria-hidden="true">
				<span class="entry__node" />
				<span class="entry__index">/{String(i + 1).padStart(2, '0')}</span>
			</div>
			<div class="entry__body">
				<p class="entry__period">{job.period}</p>
				<h3 class="entry__title">{job.title}</h3>
				<p class="entry__company">
					{job.companyUrl ? (
						<a href={job.companyUrl} target="_blank" rel="noopener noreferrer">
							@{job.company} ↗
						</a>
					) : (
						<span>@{job.company}</span>
					)}
					<span aria-hidden="true"> — </span>
					{job.location}
				</p>
				<p class="entry__desc">{job.description}</p>
				<ul class="entry__points">
					{job.highlights.map((point) => (
						<li class="entry__point">{point}</li>
					))}
				</ul>
				<div class="tag-list">
					{job.stack.map((tech) => (
						<span class="tag">{tech}</span>
					))}
				</div>
			</div>
		</li>
	))}
</ol>

<style>
	.track {
		position: relative;
		display: grid;
		border-top: 2px solid var(--ink);
	}

	/* the rail rule everything hangs off */
	.track::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 31px;
		width: 2px;
		background: var(--ink);
	}

	.entry {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: clamp(16px, 3vw, 40px);
		padding: clamp(28px, 4vw, 44px) 0;
		border-bottom: 2px solid var(--ink);
	}

	.entry__rail {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
	}

	.entry__node {
		width: 18px;
		height: 18px;
		margin-left: 21px;
		margin-top: 8px;
		flex-shrink: 0;
		background: var(--accent);
		border: 2px solid var(--ink);
		position: relative;
		z-index: 1;
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.entry:hover .entry__node {
		transform: rotate(45deg);
	}

	.entry__index {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-faint);
	}

	.entry__period {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.entry__title {
		margin-top: 12px;
		font-size: clamp(26px, 4vw, 44px);
	}

	.entry__company {
		margin-top: 10px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-muted);
	}

	.entry__company a {
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
	}

	.entry__company a:hover {
		color: var(--accent);
	}

	.entry__desc {
		margin-top: 12px;
		max-width: 68ch;
		color: var(--text-muted);
		font-weight: 500;
	}

	.entry__points {
		display: grid;
		gap: 12px;
		margin: 22px 0;
	}

	.entry__point {
		position: relative;
		padding-left: 26px;
		max-width: 74ch;
		color: var(--text-muted);
		font-weight: 500;
	}

	.entry__point::before {
		content: '■';
		position: absolute;
		left: 0;
		top: 2px;
		font-size: 11px;
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.track::before {
			left: 21px;
		}

		.entry {
			grid-template-columns: 44px minmax(0, 1fr);
		}

		.entry__node {
			margin-left: 11px;
		}
	}
</style>
