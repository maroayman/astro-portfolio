---
interface Props {
	id?: string;
	/** Two-digit section index in the mono label, e.g. "01". */
	index?: string;
	/** Mono label next to the index, e.g. "Capabilities". */
	label?: string;
	title?: string;
	sub?: string;
	divided?: boolean;
}

const { id, index, label, title, sub, divided = true } = Astro.props;
---

<section class="section" id={id} class:list={[{ 'section--divided': divided }]}>
	<div class="shell">
		{(index || title || sub) && (
			<header class="section__head reveal">
				{index && (
					<p class="section__label">
						<b>{index}</b>
						<span>{label}</span>
					</p>
				)}
				{title && <h2 class="section__title">{title}</h2>}
				{sub && <p class="section__sub">{sub}</p>}
			</header>
		)}
		<slot />
	</div>
</section>

<style>
	.section--divided {
		border-top: 1px dashed var(--line);
	}
</style>
