---
import { formatDate, postSlug, tagSlug, type BlogPost } from '../utils/blog';

interface Props {
	post: BlogPost;
	index: number;
}

const { post, index } = Astro.props;
---

<li
	class="reveal"
	style={`--reveal-delay:${(index % 4) * 60}ms`}
	data-post-tags={post.data.tags.map(tagSlug).join(' ')}
	data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
>
	<a class="row" href={`/blog/${postSlug(post)}/`}>
		<span class="row__index" aria-hidden="true">
			{String(index + 1).padStart(2, '0')}
		</span>
		<span class="row__main">
			<span class="row__meta">
				{formatDate(post.data.date)} — {post.data.tags.join(' · ') || 'Notes'}
			</span>
			<h3 class="row__title">{post.data.title}</h3>
			<span class="row__desc">{post.data.description}</span>
		</span>
		<span class="row__arrow" aria-hidden="true">
			→
		</span>
	</a>
</li>

<style>
	.row {
		display: grid;
		grid-template-columns: 70px minmax(0, 1fr) auto;
		gap: clamp(14px, 2.5vw, 32px);
		align-items: start;
		padding: clamp(22px, 3vw, 32px) clamp(12px, 2.5vw, 28px);
		border-bottom: 2px solid var(--ink);
		transition: background-color 0.18s ease;
	}

	.row:hover {
		background: var(--ink);
		color: var(--bg);
	}

	.row__index {
		font-size: 15px;
		font-weight: 800;
		color: var(--accent);
	}

	.row__meta {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.row:hover .row__meta {
		color: var(--bg);
		opacity: 0.7;
	}

	.row__title {
		display: block;
		margin-top: 10px;
		font-size: clamp(22px, 3.2vw, 36px);
	}

	.row__desc {
		display: block;
		margin-top: 10px;
		max-width: 64ch;
		color: var(--text-muted);
		font-weight: 500;
		font-size: 15px;
	}

	.row:hover .row__desc {
		color: var(--bg);
		opacity: 0.8;
	}

	.row__arrow {
		font-size: 24px;
		font-weight: 800;
		transition: transform 0.2s ease;
	}

	.row:hover .row__arrow {
		transform: translateX(6px);
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: 1fr;
			gap: 10px;
		}

		.row__arrow {
			display: none;
		}
	}
</style>
