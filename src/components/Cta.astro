---
import { profile, icons } from '../data/portfolio';

const channels = [
	{ href: profile.links.github, label: 'GitHub', handle: 'maroayman', icon: icons.github },
	{ href: profile.links.gitlab, label: 'GitLab', handle: 'maroayman', icon: icons.gitlab },
	{ href: profile.links.linkedin, label: 'LinkedIn', handle: 'in/maroayman', icon: icons.linkedin },
	{
		href: 'https://www.upwork.com/freelancers/~0142a1533e4a586cfb',
		label: 'Upwork',
		handle: 'maroayman',
		icon: icons.upwork,
	},
	{
		href: 'https://www.freelancer.com/u/maroayman2000',
		label: 'Freelancer',
		handle: 'maroayman2000',
		icon: icons.freelancer,
	},
	{ href: profile.links.linktree, label: 'Linktree', handle: 'maroayman', icon: icons.linktree },
];
---

<div class="cta reveal">
	<p class="cta__label">Open channel_</p>
	<p class="cta__title">
		<slot name="title">Let's build something that scales.</slot>
	</p>
	<p class="cta__sub">
		<slot name="sub">
			Whether it's a platform role, a migration you're dreading, or just a strong opinion about YAML
			— my inbox is open.
		</slot>
	</p>

	<div class="cta__actions">
		<a class="btn btn--signal" href={`mailto:${profile.email}`}>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d={icons.mail}></path>
			</svg>
			{profile.email}
		</a>
		<a class="btn" href={profile.phoneHref}>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d={icons.phone}></path>
			</svg>
			{profile.phone}
		</a>
		<button class="btn" type="button" data-copy={profile.email}>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d={icons.copy}></path>
			</svg>
			<span data-copy-label aria-live="polite">
				Copy mail
			</span>
		</button>
	</div>

	<ul class="channels">
		{channels.map((channel) => (
			<li>
				<a class="channel" href={channel.href} target="_blank" rel="noopener noreferrer">
					<span class="channel__icon">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d={channel.icon}></path>
						</svg>
					</span>
					<span class="channel__label">{channel.label}</span>
					<span class="channel__handle">{channel.handle}</span>
					<span class="channel__go" aria-hidden="true">
						↗
					</span>
				</a>
			</li>
		))}
	</ul>
</div>

<style>
	.cta {
		border: 1px solid var(--line-strong);
		border-radius: var(--r);
		background: var(--bg-elevated);
		color: var(--text);
		padding: clamp(28px, 4vw, 48px) clamp(22px, 4vw, 44px);
	}

	.cta__label {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	.cta__title {
		margin-top: 14px;
		font-size: clamp(24px, 4vw, 44px);
		font-weight: 600;
		line-height: 1.15;
		max-width: 20ch;
	}

	.cta__sub {
		margin-top: 14px;
		max-width: 56ch;
		color: var(--text-muted);
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.channels {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 10px;
		margin-top: 32px;
		padding-top: 24px;
		border-top: 1px solid var(--line-strong);
	}

	.channel {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px;
		border: 1px solid var(--line-strong);
		border-radius: var(--r);
		transition:
			background-color 0.18s ease,
			color 0.18s ease,
			border-color 0.18s ease;
	}

	.channel:hover {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}

	.channel__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
	}

	.channel__icon svg {
		width: 18px;
		height: 18px;
	}

	.channel__label {
		font-weight: 600;
		font-size: 13px;
	}

	.channel__handle {
		font-family: var(--font-mono);
		font-size: 11px;
		opacity: 0.7;
	}

	.channel__go {
		margin-left: auto;
		font-size: 18px;
		font-weight: 600;
	}

	@media (max-width: 760px) {
		.channels {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	/** Falls back to execCommand where the async clipboard API is unavailable (e.g. plain http). */
	async function copyText(text: string): Promise<boolean> {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const field = document.createElement('textarea');
			field.value = text;
			field.setAttribute('readonly', '');
			field.style.position = 'fixed';
			field.style.opacity = '0';
			document.body.append(field);
			field.select();
			const ok = document.execCommand('copy');
			field.remove();
			return ok;
		}
	}

	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		const label = button.querySelector<HTMLElement>('[data-copy-label]');
		let timer: ReturnType<typeof setTimeout>;

		button.addEventListener('click', async () => {
			const ok = await copyText(button.dataset.copy ?? '');
			if (label) label.textContent = ok ? 'Copied' : 'Press ⌘C';
			clearTimeout(timer);
			timer = setTimeout(() => {
				if (label) label.textContent = 'Copy mail';
			}, 2000);
		});
	});
</script>
