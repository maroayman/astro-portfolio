---
import { certifications } from '../data/portfolio';
---

<ul class="certs">
	{certifications.map((cert, i) => (
		<li class="cert reveal" style={`--reveal-delay:${(i % 2) * 60}ms`}>
			<span class="cert__box" aria-hidden="true">
				✓
			</span>
			<span class="cert__text">
				<span class="cert__name">{cert.title}</span>
				<span class="cert__meta">
					{cert.issuer} · {cert.date}
				</span>
			</span>
			<span class="cert__index" aria-hidden="true">
				{String(i + 1).padStart(2, '0')}
			</span>
		</li>
	))}
</ul>

<style>
	.certs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border: 1px solid var(--line-strong);
		border-radius: var(--r);
		background: var(--bg-elevated);
	}

	.cert {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 18px;
	}

	.cert:nth-child(odd) {
		border-right: 1px solid var(--line-strong);
	}

	.cert:nth-child(n + 3) {
		border-top: 1px solid var(--line-strong);
	}

	.cert__box {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		flex-shrink: 0;
		border: 1px solid var(--accent);
		border-radius: var(--r);
		color: var(--accent);
		font-size: 14px;
		font-weight: 600;
	}

	.cert__text {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.cert__name {
		font-weight: 600;
		font-size: 15px;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.cert__meta {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-faint);
	}

	.cert__index {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-faint);
	}

	@media (max-width: 720px) {
		.certs {
			grid-template-columns: 1fr;
		}

		.cert:nth-child(odd) {
			border-right: none;
		}

		.cert:nth-child(n + 2) {
			border-top: 1px solid var(--line-strong);
		}
	}
</style>
