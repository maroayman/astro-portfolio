---
import { projects } from '../data/portfolio';

interface Props {
	limit?: number;
}

const { limit } = Astro.props;
const items = typeof limit === 'number' ? projects.slice(0, limit) : projects;
---

<ul class="list">
	{items.map((project, i) => {
		const Tag = project.link ? 'a' : 'article';
		return (
			<li class="reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
				<Tag
					class="row"
					{...(project.link
						? { href: project.link, target: '_blank', rel: 'noopener noreferrer' }
						: {})}
				>
					<span class="row__index" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<span class="row__main">
						<h3 class="row__name">
							{project.name}
							{project.link && (
								<span class="row__arrow" aria-hidden="true">
									↗
								</span>
							)}
						</h3>
						<p class="row__desc">{project.description}</p>
						<span class="tag-list row__tags">
							{project.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</span>
					</span>
					{project.metric && <span class="row__metric">{project.metric}</span>}
				</Tag>
			</li>
		);
	})}
</ul>

<style>
	.list {
		display: grid;
		border-top: 2px solid var(--ink);
	}

	.list > li {
		border-bottom: 2px solid var(--ink);
	}

	.row {
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr) auto;
		gap: clamp(14px, 2.5vw, 32px);
		align-items: start;
		padding: clamp(24px, 3.5vw, 38px) clamp(12px, 2.5vw, 28px);
		transition:
			background-color 0.18s ease,
			color 0.18s ease;
	}

	a.row:hover {
		background: var(--ink);
		color: var(--bg);
	}

	a.row:hover .row__desc {
		color: var(--bg);
		opacity: 0.75;
	}

	a.row:hover .tag {
		background: transparent;
		border-color: var(--bg);
		color: var(--bg);
	}

	a.row:hover .row__metric {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}

	a.row:hover .row__arrow {
		transform: translate(4px, -4px);
		color: var(--accent);
	}

	[data-theme='dark'] a.row:hover .row__arrow {
		color: var(--accent);
	}

	.row__index {
		font-size: 15px;
		font-weight: 800;
		color: var(--accent);
	}

	.row__name {
		display: flex;
		align-items: baseline;
		gap: 12px;
		font-size: clamp(26px, 4vw, 46px);
	}

	.row__arrow {
		font-size: 0.7em;
		transition: transform 0.2s ease;
	}

	.row__desc {
		margin: 12px 0 18px;
		max-width: 62ch;
		color: var(--text-muted);
		font-weight: 500;
	}

	.row__metric {
		padding: 8px 14px;
		border: 2px solid var(--ink);
		background: var(--accent-soft);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		.row {
			grid-template-columns: 56px minmax(0, 1fr);
		}

		.row__metric {
			grid-column: 2;
			justify-self: start;
		}
	}
</style>
