---
import { skills } from '../data/portfolio';

interface Props {
	limit?: number;
}

const { limit } = Astro.props;
const items = typeof limit === 'number' ? skills.slice(0, limit) : skills;
---

<ul class="table">
	{items.map((group, i) => (
		<li class="row reveal" style={`--reveal-delay:${(i % 4) * 60}ms`}>
			<span class="row__index" aria-hidden="true">
				/{String(i + 1).padStart(2, '0')}
			</span>
			<div class="row__main">
				<h3 class="row__title">{group.title}</h3>
				<p class="row__summary">{group.summary}</p>
			</div>
			<div class="row__side">
				<div class="tag-list">
					{group.items.map((item) => (
						<span class="tag">{item}</span>
					))}
				</div>
				<span class="row__count">{String(group.items.length).padStart(2, '0')} tools</span>
			</div>
		</li>
	))}
</ul>

<style>
	.table {
		border-top: 1px solid var(--line-strong);
	}

	.row {
		display: grid;
		grid-template-columns: 70px minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(16px, 3vw, 44px);
		align-items: start;
		padding: clamp(24px, 3.5vw, 36px) clamp(12px, 2.5vw, 28px);
		border-bottom: 1px solid var(--line-strong);
		transition: background-color 0.2s ease;
	}

	.row:hover {
		background: var(--accent-soft);
	}

	.row__index {
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
	}

	.row__title {
		font-size: clamp(19px, 2.6vw, 26px);
	}

	.row__summary {
		margin-top: 10px;
		max-width: 44ch;
		color: var(--text-muted);
		font-weight: 500;
	}

	.row__side {
		display: grid;
		gap: 14px;
	}

	.row__count {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	@media (max-width: 860px) {
		.row {
			grid-template-columns: 56px 1fr;
		}

		.row__side {
			grid-column: 2;
		}
	}

	@media (max-width: 520px) {
		.row {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.row__side {
			grid-column: 1;
		}
	}
</style>
