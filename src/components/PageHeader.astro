---
interface Props {
	index?: string;
	label?: string;
	title: string;
	sub?: string;
}

const { index, label, title, sub } = Astro.props;
---

<header class="page-head">
	<div class="shell">
		<slot name="crumbs" />
		{index && (
			<p class="page-head__index reveal" aria-hidden="true">
				{index}
			</p>
		)}
		{label && <p class="page-head__label reveal">{label}</p>}
		<h1 class="page-head__title reveal">{title}</h1>
		{sub && <p class="page-head__sub reveal">{sub}</p>}
		<slot />
	</div>
</header>

<style>
	.page-head {
		padding-block: clamp(56px, 9vw, 110px) clamp(32px, 5vw, 56px);
		border-bottom: 2px solid var(--ink);
	}

	.page-head__index {
		font-size: clamp(56px, 9vw, 110px);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1;
		color: var(--accent);
	}

	.page-head__label {
		margin-top: 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.page-head__title {
		margin-top: 12px;
		font-size: clamp(48px, 9vw, 120px);
		max-width: 10ch;
	}

	.page-head__sub {
		margin-top: 20px;
		max-width: 58ch;
		color: var(--text-muted);
		font-size: clamp(16px, 1.8vw, 19px);
		font-weight: 500;
	}
</style>
