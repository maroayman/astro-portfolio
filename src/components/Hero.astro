---
import Availability from './Availability.astro';
import { profile, stats, activity, icons } from '../data/portfolio';

const socials = [
	{ href: profile.links.github, label: 'GitHub', icon: icons.github },
	{ href: profile.links.linkedin, label: 'LinkedIn', icon: icons.linkedin },
	{ href: profile.links.gitlab, label: 'GitLab', icon: icons.gitlab },
];
---

<section class="hero">
	<div class="shell">
		<p class="hero__kicker">
			<span>{profile.role}</span>
			<span aria-hidden="true">/</span>
			<span>{profile.location}</span>
			<span aria-hidden="true">/</span>
			<Availability />
		</p>

		<h1 class="hero__title">
			I make
			<br />
			deploys <span class="hero__outline">boring</span>
			<span class="hero__dot">.</span>
		</h1>

		<div class="hero__row">
			<p class="hero__intro">
				I'm <strong>{profile.name}</strong> — {profile.intro}
			</p>
			<div class="hero__actions">
				<a class="btn btn--primary" href="/projects">
					Selected work
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d={icons.arrow}></path>
					</svg>
				</a>
				<a class="btn" href="/contact">
					Hire me
				</a>
			</div>
		</div>

		<dl class="hero__stats">
			{stats.map((stat) => (
				<div class="hero__stat">
					<dt class="hero__value">{stat.value}</dt>
					<dd class="hero__label">{stat.label}</dd>
				</div>
			))}
		</dl>

		<div class="hero__bottom">
			<div class="hero__log" aria-label="Recent shipping activity">
				<p class="hero__log-title">Latest shipments_</p>
				<ul>
					{activity.slice(0, 3).map((line) => (
						<li>
							<span>{line.date}</span>
							<span>{line.text}</span>
							<span class="hero__log-status">{line.status === 'shipped' ? '[✓]' : '[…]'}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="socials">
				{socials.map((social) => (
					<a
						class="social"
						href={social.href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={social.label}
					>
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d={social.icon}></path>
						</svg>
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px);
	}

	.hero__kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.hero__title {
		margin-top: 24px;
		font-size: clamp(58px, 12.5vw, 168px);
	}

	.hero__outline {
		color: transparent;
		-webkit-text-stroke: 2.5px var(--text);
	}

	.hero__dot {
		color: var(--accent);
	}

	.hero__row {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) auto;
		gap: 28px;
		align-items: end;
		margin-top: 32px;
	}

	.hero__intro {
		max-width: 56ch;
		color: var(--text-muted);
		font-size: clamp(16px, 1.8vw, 19px);
		font-weight: 500;
	}

	.hero__intro strong {
		color: var(--text);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.hero__stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: clamp(36px, 5vw, 60px) 0 0;
		border: 2px solid var(--ink);
		background: var(--bg-elevated);
		box-shadow: var(--shadow-hard);
	}

	.hero__stat {
		padding: 22px 20px;
	}

	.hero__stat + .hero__stat {
		border-left: 2px solid var(--ink);
	}

	.hero__value {
		font-size: clamp(30px, 4vw, 46px);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.hero__stat:nth-child(2) .hero__value {
		color: var(--accent);
	}

	.hero__label {
		margin: 8px 0 0;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero__bottom {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 20px;
		align-items: center;
		margin-top: 28px;
	}

	.hero__log {
		border: 2px solid var(--ink);
		background: var(--bg-sunken);
	}

	.hero__log-title {
		padding: 8px 14px;
		border-bottom: 2px solid var(--ink);
		background: var(--ink);
		color: var(--bg);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.hero__log ul {
		display: grid;
	}

	.hero__log li {
		display: flex;
		gap: 14px;
		padding: 10px 14px;
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.hero__log li + li {
		border-top: 1px dashed var(--line-strong);
	}

	.hero__log li span:first-child {
		flex-shrink: 0;
		color: var(--text-faint);
	}

	.hero__log li span:nth-child(2) {
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero__log-status {
		flex-shrink: 0;
		color: var(--accent);
		font-weight: 500;
	}

	.socials {
		display: flex;
		gap: 10px;
	}

	.social {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 2px solid var(--ink);
		background: var(--bg-elevated);
		color: var(--text);
		box-shadow: 4px 4px 0 var(--ink);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			background-color 0.15s ease,
			color 0.15s ease;
	}

	.social:hover {
		transform: translate(-2px, -2px);
		box-shadow: 6px 6px 0 var(--ink);
		background: var(--ink);
		color: var(--bg);
	}

	.social svg {
		width: 18px;
		height: 18px;
	}

	@media (max-width: 900px) {
		.hero__row {
			grid-template-columns: 1fr;
		}

		.hero__stats {
			grid-template-columns: 1fr 1fr;
		}

		.hero__stat:nth-child(3) {
			border-left: none;
		}

		.hero__stat:nth-child(n + 3) {
			border-top: 2px solid var(--ink);
		}

		.hero__bottom {
			grid-template-columns: 1fr;
		}
	}
</style>
