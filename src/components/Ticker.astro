---
interface Props {
	items: string[];
}

const { items } = Astro.props;
const group = [...items, ...items];
---

<div class="ticker" aria-hidden="true">
	<div class="ticker__track">
		{[0, 1].map(() => (
			<div class="ticker__group">
				{group.map((item) => (
					<span class="ticker__item">
						{item} <i>✳</i>
					</span>
				))}
			</div>
		))}
	</div>
</div>

<style>
	.ticker {
		overflow: hidden;
		background: var(--ink);
		color: var(--bg);
		padding-block: 12px;
	}

	.ticker__track {
		display: flex;
		width: max-content;
		animation: ticker-scroll 30s linear infinite;
	}

	.ticker__group {
		display: flex;
		align-items: center;
		gap: 34px;
		padding-right: 34px;
	}

	.ticker__item {
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.ticker__item i {
		font-style: normal;
		color: var(--accent);
		margin-left: 34px;
	}

	[data-theme='dark'] .ticker__item i {
		color: var(--accent);
	}

	@keyframes ticker-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker__track {
			animation: none;
		}
	}
</style>
