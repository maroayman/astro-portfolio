---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	trail: Crumb[];
}

const { trail } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
	<ol>
		{trail.map((item, i) => (
			<li>
				{i > 0 && (
					<span class="crumbs__sep" aria-hidden="true">
						/
					</span>
				)}
				{item.href ? (
					<a href={item.href}>{item.label}</a>
				) : (
					<span aria-current="page">{item.label}</span>
				)}
			</li>
		))}
	</ol>
</nav>

<style>
	.crumbs {
		margin-bottom: 22px;
	}

	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}

	.crumbs li {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.crumbs a {
		color: var(--text-muted);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.crumbs a:hover {
		color: var(--accent);
	}

	.crumbs [aria-current='page'] {
		color: var(--text);
		font-weight: 700;
	}

	.crumbs__sep {
		color: var(--text-faint);
	}
</style>
