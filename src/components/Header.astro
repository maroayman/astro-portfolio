---
import Availability from './Availability.astro';
import { profile } from '../data/portfolio';

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/skills', label: 'Stack' },
	{ href: '/experience', label: 'Track' },
	{ href: '/projects', label: 'Builds' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
	<div class="shell header__inner">
		<a class="brand" href="/" aria-label={`${profile.name} — home`}>
			<span class="brand__mark" aria-hidden="true">
				MA®
			</span>
		</a>

		<nav class="nav" aria-label="Main">
			{nav.map((item) => (
				<a
					class="nav__link"
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="bar__actions">
			<span class="avail">
				<Availability />
			</span>
			<button
				class="theme-toggle"
				type="button"
				data-theme-toggle
				aria-pressed="false"
				aria-label="Dark theme"
			>
				<svg
					class="theme-toggle__sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4.2"></circle>
					<path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
				</svg>
				<svg
					class="theme-toggle__moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
				</svg>
			</button>
		</div>
	</div>

	<div class="progress" role="presentation">
		<span class="progress__bar" data-progress></span>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
		border-bottom: 2px solid var(--ink);
	}

	.header__inner {
		height: var(--header-h);
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.brand__mark {
		display: inline-block;
		padding: 6px 10px;
		background: var(--ink);
		color: var(--bg);
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -0.02em;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	.brand:hover .brand__mark {
		background: var(--accent);
		color: var(--accent-ink);
	}

	.nav {
		display: flex;
		gap: 2px;
		margin-inline: auto;
	}

	.nav__link {
		padding: 8px 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
		border: 2px solid transparent;
	}

	.nav__link:hover {
		color: var(--text);
		border-color: var(--ink);
	}

	.nav__link[aria-current='page'] {
		background: var(--ink);
		color: var(--bg);
	}

	.bar__actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.avail {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border: 2px solid var(--ink);
		border-radius: var(--r);
		background: var(--bg-elevated);
		color: var(--text);
		box-shadow: 3px 3px 0 var(--ink);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.theme-toggle:hover {
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--ink);
	}

	.theme-toggle:active {
		transform: translate(2px, 2px);
		box-shadow: 0 0 0 var(--ink);
	}

	.theme-toggle svg {
		width: 16px;
		height: 16px;
		grid-area: 1 / 1;
	}

	:root[data-theme='dark'] .theme-toggle__moon,
	:root:not([data-theme='dark']) .theme-toggle__sun {
		display: none;
	}

	.progress {
		height: 4px;
		background: transparent;
	}

	.progress__bar {
		display: block;
		height: 100%;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		will-change: transform;
	}

	@media (max-width: 760px) {
		.avail {
			display: none;
		}

		.header__inner {
			gap: 12px;
		}

		.nav {
			overflow-x: auto;
			scrollbar-width: none;
		}

		.nav::-webkit-scrollbar {
			display: none;
		}

		.nav__link {
			padding: 8px 10px;
			white-space: nowrap;
		}
	}
</style>

<script>
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

	function syncToggle() {
		if (!button) return;
		const isDark = root.dataset.theme === 'dark';
		button.setAttribute('aria-pressed', String(isDark));
		button.setAttribute('aria-label', isDark ? 'Dark theme (on)' : 'Light theme (on)');
	}

	syncToggle();

	button?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {
			/* storage blocked — the toggle still works for this page view */
		}
		syncToggle();
	});

	const bar = document.querySelector<HTMLElement>('[data-progress]');

	if (bar) {
		let ticking = false;

		const update = () => {
			const scrollable = document.documentElement.scrollHeight - window.innerHeight;
			const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
			bar.style.transform = `scaleX(${progress})`;
			ticking = false;
		};

		addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(update);
					ticking = true;
				}
			},
			{ passive: true },
		);

		update();
	}
</script>
