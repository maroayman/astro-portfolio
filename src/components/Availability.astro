---
import { availabilityState } from '../data/portfolio';

const state = availabilityState;
---

<span class="availability" style={`--avail:${state.color}`}>
	<i aria-hidden="true"></i>
	<span>{state.label}</span>
</span>

<style>
	.availability {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font: inherit;
	}

	.availability i {
		width: 9px;
		height: 9px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--avail);
		box-shadow: 0 0 10px 1px var(--avail);
	}
</style>
