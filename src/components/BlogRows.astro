---
import { formatDate, postSlug, type BlogPost } from '../utils/blog';

interface Props {
	/** Posts to render (already ordered newest-first). */
	posts: BlogPost[];
	/** Global index of posts[0] within the full sorted archive (kept for compat). */
	startIndex?: number;
}

const { posts } = Astro.props;
---

<ol class="plain-list">
	{posts.map((post) => (
		<li class="plain-row">
			<time class="archive-date" datetime={post.data.date.toISOString()}>
				{formatDate(post.data.date)}
			</time>
			<a class="plain-title" href={`/blog/${postSlug(post)}/`}>
				{post.data.title}
			</a>
		</li>
	))}
</ol>

<style>
	.plain-list {
		list-style: none;
		padding: 0;
		margin: 32px 0 0;
	}
	.plain-row {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 8px 16px;
		align-items: baseline;
		padding: 6px 0;
	}
	.archive-date {
		color: var(--mute);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.plain-title {
		color: var(--fg);
		text-decoration: none;
		font-size: 1.4rem;
	}
	.plain-title:hover,
	.plain-title:focus-visible {
		color: var(--acc);
		text-decoration: none !important;
	}
</style>
