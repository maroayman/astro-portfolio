---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Ticker from '../components/Ticker.astro';
import Section from '../components/Section.astro';
import ProjectRows from '../components/ProjectRows.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';

const marquee = [
	'Open source',
	'Internal tooling',
	'Platform',
	'Reliability',
	'Security',
	'DX',
	'Observability',
];
---

<Layout
	title="Builds"
	description="Selected DevOps and infrastructure projects by Marwan Ayman Shawky — GitOps on EKS, Terraform on AWS, Docker stacks, and automation."
>
	<Header />
	<main id="main">
		<PageHeader
			index="03"
			label="Selected work"
			title="Projects & open source"
			sub="GitOps pipelines, Terraform infrastructure, and containerized apps — plus the earlier dev projects that got me here."
		>
			<Breadcrumb slot="crumbs" trail={[{ label: 'Home', href: '/' }, { label: 'Builds' }]} />
		</PageHeader>

		<Ticker items={marquee} />

		<Section
			divided={false}
			title="Everything shipped"
			sub="Twelve of them — DevOps builds first, then the earlier dev work that got me here."
		>
			<ProjectRows />
		</Section>

		<Section>
			<Cta>
				<span slot="title">Want the code?</span>
				<span slot="sub">
					Most of this lives on GitHub. Tell me what you're building and I'll point you at the
					relevant repo.
				</span>
			</Cta>
		</Section>
	</main>
	<Footer />
</Layout>
