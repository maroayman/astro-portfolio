---
import TilesLayout from '../layouts/TilesLayout.astro';
import Ticker from '../components/Ticker.astro';
import Section from '../components/Section.astro';
import ProjectRows from '../components/ProjectRows.astro';
import Cta from '../components/Cta.astro';
import { projects } from '../data/portfolio';

const uniq = (items: string[]) => [...new Set(items)];

const marquee = [
	'Open source',
	'Internal tooling',
	'Platform',
	'Reliability',
	'Security',
	'DX',
	'Observability',
];
---

<TilesLayout
	windowId="projects"
	title="Builds"
	description="Selected DevOps and infrastructure projects by Marwan Ayman Shawky — GitOps on EKS, Terraform on AWS, Docker stacks, and automation."
	file="projects.md"
	docTitle="Projects & open source"
	intro="GitOps pipelines, Terraform infrastructure, and containerized apps — plus the earlier dev projects that got me here."
	entries={projects.map((project) => ({
		text: `${project.name} — ${project.tags.slice(0, 2).join(' · ')}`,
		href: project.link,
		external: Boolean(project.link),
	}))}
	tags={uniq(projects.flatMap((project) => project.tags))}
>
	<Ticker items={marquee} />

	<Section
		divided={false}
		title="Everything shipped"
		sub="Twelve of them — DevOps builds first, then the earlier dev work that got me here."
	>
		<ProjectRows />
	</Section>

	<Section>
		<Cta>
			<span slot="title">Want the code?</span>
			<span slot="sub">
				Most of this lives on GitHub. Tell me what you're building and I'll point you at the
				relevant repo.
			</span>
		</Cta>
	</Section>
</TilesLayout>
