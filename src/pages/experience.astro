---
import KineticLayout from '../layouts/KineticLayout.astro';
import { experience } from '../data/portfolio';
---

<KineticLayout
	title="Experience"
	description="Career history of Marwan Ayman Shawky, a Cloud & DevOps Engineer working with Kubernetes, Terraform, CI/CD, and GitOps."
	active="/experience"
>
	<div class="body">
		<p class="crumb"><a href="/">Home</a> / Experience</p>
		<h1 class="ptitle" id="name">Experience</h1>
		<ul class="klist">
			{
				experience.map((role) => (
					<li class="krow">
						<div>
							<h2>
								{role.companyUrl ? (
									<a href={role.companyUrl}>{role.company}</a>
								) : (
									<span>{role.company}</span>
								)}
							</h2>
							<p class="kmeta">
								{role.title} · {role.period} · {role.location}
							</p>
							<div class="kdesc">
								<p>{role.description}</p>
								<ul>
									{role.highlights.map((h) => (
										<li>{h}</li>
									))}
								</ul>
							</div>
							<ul class="ktags" aria-label="Stack">
								{role.stack.map((s) => (
									<li>{s}</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ul>
		<p><a class="back" href="/">← Home</a></p>
	</div>
</KineticLayout>
