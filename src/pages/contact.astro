---
import TilesLayout from '../layouts/TilesLayout.astro';
import Section from '../components/Section.astro';
import Cta from '../components/Cta.astro';
import { profile, icons, availabilityState } from '../data/portfolio';

const looking = [
	{
		title: 'Cloud / DevOps Engineer',
		detail:
			'Full-time roles across Kubernetes, Terraform, CI/CD, and GitOps — Cairo, remote, or hybrid.',
		link: null,
	},
	{
		title: 'Cloud & automation projects',
		detail:
			'Short engagements: pipeline builds, IaC rollouts, containerization, cloud provisioning.',
		link: null,
	},
	{
		title: 'Freelance gigs',
		detail: 'Available for freelance infrastructure work — find me on the usual platforms.',
		link: null,
	},
];

const expectations = [
	'I reply to every serious message within a couple of days.',
	'Cairo based, remote-friendly — timezone-flexible with Europe and the GCC.',
	'Prefer talking? Call or message — the number is below the email box.',
];

const channels = [
	{ text: `mail — ${profile.email}`, href: `mailto:${profile.email}` },
	{ text: `tel — ${profile.phone}`, href: profile.phoneHref },
	{ text: 'gh — github.com/maroayman', href: profile.links.github, external: true },
	{ text: 'in — linkedin.com/in/maroayman', href: profile.links.linkedin, external: true },
	{ text: 'gl — gitlab.com/maroayman', href: profile.links.gitlab, external: true },
	{ text: 'tree — linktr.ee/maroayman', href: profile.links.linktree, external: true },
];
---

<TilesLayout
	windowId="contact"
	title="Contact"
	description="Get in touch with Marwan Ayman Shawky, Cloud & DevOps Engineer in Cairo, Egypt. Available for DevOps roles, cloud work, and freelance gigs."
	file="contact.md"
	docTitle="Let's talk infrastructure."
	intro="Whether it's a platform role, a migration you're dreading, or just a strong opinion about YAML — my inbox is open."
	entries={channels}
	tags={['mail', 'tel', 'github', 'linkedin', 'gitlab', 'linktree']}
	tagsUnit="links"
>
	<Section divided={false}>
		<Cta>
			<span slot="title">Get in touch</span>
			<span slot="sub">
				{availabilityState.label} · {profile.location}
			</span>
		</Cta>
	</Section>

	<Section
		index="05"
		label="Fit check"
		title="What I'm looking for"
		sub="A short list, so you can tell quickly whether this is worth an email."
	>
		<ul class="roles">
			{looking.map((item, i) => (
				<li class="role reveal" style={`--reveal-delay:${i * 70}ms`}>
					<span class="role__index" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<div>
						<h2 class="role__title">{item.title}</h2>
						<p class="role__detail">{item.detail}</p>
					</div>
					<svg
						class="role__icon"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d={icons.cube} />
					</svg>
				</li>
			))}
		</ul>
	</Section>

	<Section
		index="06"
		label="Good to know"
		title="Before you write"
		sub="A little expectations-setting, so neither of us wastes a coffee."
	>
		<ul class="notes">
			{expectations.map((note, i) => (
				<li class="note reveal" style={`--reveal-delay:${i * 60}ms`}>
					<span class="note__dot" aria-hidden="true" />
					{note}
				</li>
			))}
		</ul>
	</Section>
</TilesLayout>

<style>
	.roles {
		display: grid;
		border-top: 1px solid var(--line-strong);
	}

	.role {
		display: grid;
		grid-template-columns: 60px minmax(0, 1fr) 28px;
		gap: clamp(14px, 2.5vw, 28px);
		align-items: start;
		padding: clamp(22px, 3vw, 32px) 0;
		border-bottom: 1px solid var(--line-strong);
	}

	.role__index {
		color: var(--accent);
		font-size: 13px;
		font-weight: 600;
	}

	.role__title {
		font-size: clamp(20px, 2.6vw, 28px);
		font-weight: 600;
	}

	.role__detail {
		margin-top: 8px;
		max-width: 58ch;
		color: var(--text-muted);
	}

	.role__icon {
		width: 26px;
		height: 26px;
		color: var(--accent);
	}

	.notes {
		display: grid;
		border-top: 1px solid var(--line-strong);
		max-width: 76ch;
	}

	.note {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 16px 0;
		border-bottom: 1px solid var(--line-strong);
		color: var(--text-muted);
	}

	.note__dot {
		width: 10px;
		height: 10px;
		margin-top: 8px;
		flex-shrink: 0;
		background: var(--accent);
	}

	@media (max-width: 560px) {
		.role {
			grid-template-columns: 36px minmax(0, 1fr);
		}

		.role__icon {
			display: none;
		}
	}
</style>
