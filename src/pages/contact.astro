---
import KineticLayout from '../layouts/KineticLayout.astro';
import { profile, availabilityState } from '../data/portfolio';

const looking = [
  {
    title: 'Cloud / DevOps Engineer',
    detail:
      'Full-time roles across Kubernetes, Terraform, CI/CD, and GitOps — Cairo, remote, or hybrid.',
  },
  {
    title: 'Cloud & automation projects',
    detail:
      'Short engagements: pipeline builds, IaC rollouts, containerization, cloud provisioning.',
  },
  {
    title: 'Freelance gigs',
    detail: 'Available for freelance infrastructure work — find me on the usual platforms.',
  },
];

const expectations = [
  'I reply to every serious message within a couple of days.',
  'Cairo based, remote-friendly — timezone-flexible with Europe and the GCC.',
  'Prefer talking? Call or message — the number is below the email box.',
];
---

<KineticLayout
  title="Contact"
  description="Get in touch with Marwan Ayman Shawky, Cloud & DevOps Engineer in Cairo, Egypt. Available for DevOps roles, cloud work, and freelance gigs."
>
  <div class="body">
    <p class="crumb"><a href="/">Home</a> / Contact</p>
    <h1 class="ptitle" id="name">Contact</h1>
    <p class="intro">Whether it's a platform role, a migration you're dreading, or just a strong opinion about YAML — my inbox is open.</p>
    <p class="kmeta">{availabilityState.label} · {profile.location}</p>
    <ul class="klist">
      <li class="krow">
        <div>
          <p class="klabel">Email</p>
          <p class="kdesc"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        </div>
      </li>
      <li class="krow">
        <div>
          <p class="klabel">Phone</p>
          <p class="kdesc"><a href={profile.phoneHref}>{profile.phone}</a></p>
        </div>
      </li>
    </ul>
    <h2>What I'm looking for</h2>
    <ul class="klist">
      {
        looking.map((item) => (
          <li class="krow">
            <div>
              <h3>{item.title}</h3>
              <p class="kdesc">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <h2>Before you write</h2>
    <ul class="klist">
      {
        expectations.map((note) => (
          <li class="krow">
            <div>
              <p class="kdesc">{note}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p><a class="back" href="/">← Home</a></p>
  </div>
</KineticLayout>
