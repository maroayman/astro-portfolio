---
import TilesLayout from '../layouts/TilesLayout.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Section from '../components/Section.astro';
import SkillTable from '../components/SkillTable.astro';
import Timeline from '../components/Timeline.astro';
import ProjectRows from '../components/ProjectRows.astro';
import PostRow from '../components/PostRow.astro';
import CertList from '../components/CertList.astro';
import Cta from '../components/Cta.astro';
import { profile } from '../data/portfolio';
import { getPosts, postSlug, formatDate } from '../utils/blog';

const latestPosts = (await getPosts()).slice(0, 3);

const stack = [
	'Kubernetes',
	'Terraform',
	'AWS',
	'GitHub Actions',
	'Argo CD',
	'Go',
	'Prometheus',
	'Grafana',
	'Helm',
	'Vault',
	'Python',
	'Observability',
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.role,
	description: profile.intro,
	email: `mailto:${profile.email}`,
	url: Astro.site?.href,
	sameAs: Object.values(profile.links),
	knowsAbout: ['Kubernetes', 'Terraform', 'AWS', 'GCP', 'CI/CD', 'GitOps', 'Ansible', 'Docker'],
};
---

<TilesLayout
	windowId="home"
	file="home.md"
	docTitle={profile.role}
	intro={profile.intro}
	entries={latestPosts.map((post) => ({
		text: `${post.data.title} — ${formatDate(post.data.date)}`,
		href: `/blog/${postSlug(post)}/`,
	}))}
	tags={stack}
>
	<Hero />
	<Ticker items={stack} />

	<Section
		id="skills"
		index="01"
		label="Capabilities"
		title="The stack I run on"
		sub="Grouped by what I actually use them for — not by how good they look on a slide."
	>
		<SkillTable limit={4} />
		<p class="more">
			<a class="btn" href="/skills">
				Full stack →
			</a>
		</p>
	</Section>

	<Section
		id="experience"
		index="02"
		label="Track record"
		title="Experience"
		sub="Three roles so far — on-prem Kubernetes, structured training, and cloud automation."
	>
		<Timeline limit={2} />
		<p class="more">
			<a class="btn" href="/experience">
				Full history →
			</a>
		</p>
	</Section>

	<Section
		id="work"
		index="03"
		label="Selected work"
		title="Projects & open source"
		sub="Each of these started as a production problem that needed solving by hand, once, and then every week."
	>
		<ProjectRows limit={3} />
		<p class="more">
			<a class="btn" href="/projects">
				All builds →
			</a>
		</p>
	</Section>

	<Section
		index="04"
		label="Credentials"
		title="Certifications"
		sub="Formal proof I can operate under pressure, on paper at least."
	>
		<CertList />
	</Section>

	<Section
		index="05"
		label="Writing"
		title="Latest posts"
		sub="Guides and notes from the homelab — newest first."
	>
		<ul class="posts">
			{latestPosts.map((post, i) => (
				<PostRow post={post} index={i} />
			))}
		</ul>
		<p class="more">
			<a class="btn" href="/blog">
				All posts →
			</a>
		</p>
	</Section>

	<Section>
		<Cta />
	</Section>
</TilesLayout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
<style>
	.more {
		margin-top: 28px;
	}

	.posts {
		border-top: 1px solid var(--line-strong);
	}
</style>
