---
import KineticLayout from '../layouts/KineticLayout.astro';
import Crumb from '../components/Crumb.astro';
---

<KineticLayout
	title="Page not found"
	description="The page you were looking for does not exist or has moved."
>
	<div class="body">
		<Crumb trail={[{ href: '/', label: 'Home' }, { label: '404' }]} />
		<h1 class="ptitle" id="name">
			Lost
		</h1>
		<p class="intro">That page doesn't exist.</p>
		<p>Try one of these instead:</p>
		<p>
			<a class="back" href="/blog/">
				Blog
			</a>
			·
			<a class="back" href="/projects/">
				Projects
			</a>
			·
			<a class="back" href="/">
				Home
			</a>
		</p>
	</div>
</KineticLayout>
