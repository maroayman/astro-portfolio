---
import KineticLayout from '../../layouts/KineticLayout.astro';
import { getPosts, getTags, formatDate, readingTime, tagSlug, postSlug } from '../../utils/blog';

const posts = await getPosts();
const tags = await getTags();
---

<KineticLayout
	title="Blog"
	description="Notes by Marwan Ayman Shawky on Linux, Docker, Kubernetes, AWS, and DevOps — guides from real homelab and production work."
	active="/blog"
>
	<div class="body">
		<p class="crumb"><a href="/">Home</a> / Blog</p>
		<h1 class="ptitle" id="name">Blog</h1>
		<p class="intro">{posts.length} guides and notes — mostly written so future-me stops re-googling the same thing.</p>

		<div role="search">
			<input
				id="blog-search"
				class="ksearch"
				type="search"
				data-search-input
				placeholder="Filter by title, tag, or keyword…"
				autocomplete="off"
				aria-label="Filter posts"
			/>
			<label class="kselect-label" for="blog-tag-filter">Filter by topic</label>
			<select id="blog-tag-filter" class="kselect" data-tag-select>
				<option value="">All topics</option>
				{tags.map((t) => (
					<option value={t.slug}>{t.tag} ({t.count})</option>
				))}
			</select>
		</div>
		<p class="kcount">
			<span data-filter-count aria-live="polite">{posts.length} posts</span>
			{' · '}
			<button type="button" data-filter-clear hidden>Clear ×</button>
			{' · '}
			<a class="krss" href="/rss.xml">RSS ↗</a>
		</p>
		<noscript>
			<p class="kcount">Tag filtering needs JavaScript — showing all posts.</p>
		</noscript>

		<ul class="klist">
			{posts.map((post) => (
				<li
					class="krow"
					data-post-tags={post.data.tags.map(tagSlug).join(' ')}
					data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
				>
					<h2><a href={`/blog/${postSlug(post)}/`}>{post.data.title}</a></h2>
					<p class="kmeta">{formatDate(post.data.date)} · {readingTime(post.body ?? '')} min read</p>
					<p class="kdesc">{post.data.description}</p>
				</li>
			))}
		</ul>
		<p><a class="back" href="/">← Home</a></p>
	</div>
	<script>
		import '../../scripts/tag-filter';
	</script>
</KineticLayout>

<style>
	.klist [hidden] {
		display: none !important;
	}
	.kselect-label {
		display: block;
		margin-top: 12px;
		color: var(--mute);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.kselect {
		width: 100%;
		padding: 14px;
		border: 1px solid var(--fg);
		border-radius: 0;
		background: transparent;
		color: var(--fg);
		font: inherit;
		min-height: 44px;
		margin-top: 12px;
	}
	.kselect:focus {
		outline: 2px solid var(--acc);
		outline-offset: 2px;
	}
	.kselect option {
		background: var(--bg);
		color: var(--fg);
	}
	.krss {
		color: var(--mute);
	}
	.kcount button {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--acc);
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 5px;
		font: inherit;
	}
</style>
