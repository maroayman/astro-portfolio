---
import TilesLayout from '../../layouts/TilesLayout.astro';
import Section from '../../components/Section.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getTags, postSlug, formatDate } from '../../utils/blog';

const posts = await getPosts();
const tags = await getTags();
---

<TilesLayout
	windowId="blog"
	title="Blog"
	description="Notes by Marwan Ayman Shawky on Linux, Docker, Kubernetes, AWS, and DevOps — guides from real homelab and production work."
	file="blog.md"
	docTitle="Blog"
	intro={`${posts.length} guides and notes — mostly written so future-me stops re-googling the same thing.`}
	entries={posts.map((post) => ({
		text: `${post.data.title} — ${formatDate(post.data.date)}`,
		href: `/blog/${postSlug(post)}/`,
	}))}
	tags={tags.map((t) => t.tag)}
	tagsUnit="tags"
>
	<Section divided={false}>
		<div class="search" role="search">
			<label class="search__label" for="blog-search">
				Search_
			</label>
			<input
				id="blog-search"
				class="search__input"
				type="search"
				data-search-input
				placeholder="Filter by title, tag, or keyword…"
				autocomplete="off"
			/>
		</div>
		<ul class="tags" aria-label="Filter posts by tag">
			{tags.map((t) => (
				<li>
					<button class="tag tag--chip" type="button" data-tag-filter={t.slug} aria-pressed="false">
						{t.tag} <b>{t.count}</b>
					</button>
				</li>
			))}
			<li>
				<a class="tag tag--link tag--rss" href="/rss.xml">
					RSS ↗
				</a>
			</li>
		</ul>
		<p class="filter-meta">
			<span data-filter-count aria-live="polite">
				{posts.length} posts
			</span>
			<button class="filter-clear" type="button" data-filter-clear hidden>
				Clear ×
			</button>
		</p>
		<noscript>
			<p class="filter-note">Tag filtering needs JavaScript — showing all posts.</p>
		</noscript>
	</Section>

	<Section divided={false} title="All posts" sub="Newest first.">
		<ul class="list">
			{posts.map((post, i) => (
				<PostRow post={post} index={i} />
			))}
		</ul>
	</Section>
</TilesLayout>

<script>
	import '../../scripts/tag-filter';
</script>

<style>
	.search {
		display: grid;
		gap: 10px;
		margin-bottom: 22px;
	}

	.search__label {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.search__input {
		width: 100%;
		padding: 12px 14px;
		border: 1px solid var(--line-strong);
		border-radius: var(--r);
		background: var(--bg-elevated);
		color: var(--text);
		font: inherit;
		font-size: 15px;
	}

	.search__input::placeholder {
		color: var(--text-faint);
	}

	.search__input:focus {
		outline: none;
		border-color: var(--accent);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tag--link {
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.tag--link b {
		color: var(--accent);
	}

	.tag--link:hover {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}

	.tag--chip b {
		color: var(--accent);
	}

	.tag--chip[aria-pressed='true'] {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}

	.filter-meta {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 18px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.filter-clear {
		font: inherit;
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
	}

	.filter-note {
		margin-top: 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-faint);
	}

	/* .row sets display:grid, which would override [hidden] — enforce it. */
	.posts [hidden],
	.list [hidden] {
		display: none !important;
	}

	.tag--rss {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
		font-weight: 600;
	}

	.list {
		border-top: 1px solid var(--line-strong);
	}
</style>
