---
import KineticLayout from '../../layouts/KineticLayout.astro';
import { getPosts, formatDate, readingTime, tagSlug, postSlug, coverDims } from '../../utils/blog';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: postSlug(post) },
		props: {
			post,
			newer: i > 0 ? posts[i - 1] : null,
			older: i < posts.length - 1 ? posts[i + 1] : null,
		},
	}));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const mins = readingTime(post.body ?? '');
const dims = post.data.cover ? coverDims[post.data.cover] : undefined;
---

<KineticLayout title={post.data.title} description={post.data.description} active="/blog">
	<div class="body">
		<p class="crumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Post</p>
		<h1 class="ptitle post-title">{post.data.title}</h1>
		<p class="kmeta">{formatDate(post.data.date)} · {mins} min read</p>
		<p class="intro">{post.data.description}</p>

		{post.data.tags.length > 0 && (
			<ul class="ktags" aria-label="Tags">
				{post.data.tags.map((tag) => (
					<li>
						<a href={`/blog#tags=${tagSlug(tag)}`}>{tag}</a>
					</li>
				))}
			</ul>
		)}

		{post.data.cover && (
			<figure class="cover">
				<img
					src={post.data.cover}
					alt=""
					width={dims?.width}
					height={dims?.height}
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
		)}

		<!-- "prose" is the JS hook for code-copy/table-wrap (they query .prose);
		     visual styling comes from .prose-k in kinetic.css plus the extras below. -->
		<div class="prose-k prose">
			<Content />
		</div>

		<nav class="pagenav" aria-label="More posts">
			{older ? (
				<a href={`/blog/${postSlug(older)}/`}>
					← Older
					<strong>{older.data.title}</strong>
				</a>
			) : (
				<span />
			)}
			{newer ? (
				<a href={`/blog/${postSlug(newer)}/`}>
					Newer →
					<strong>{newer.data.title}</strong>
				</a>
			) : (
				<span />
			)}
		</nav>
		<p><a class="back" href="/blog/">← Blog</a></p>
	</div>
	<script>
		import '../../scripts/code-copy';
		import '../../scripts/table-wrap';
		import '../../scripts/lightbox';
	</script>
</KineticLayout>

<style>
	.post-title {
		font-size: clamp(2.2rem, 6vw, 4.5rem);
	}
	.ktags a {
		color: inherit;
		text-decoration: none;
	}
	.ktags a:hover {
		color: var(--fg);
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.cover {
		margin: 28px 0 0;
	}
	.cover img {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--line);
	}
	.prose-k :global(table) {
		display: block;
		width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}
	.prose-k :global(th),
	.prose-k :global(td) {
		border: 1px solid var(--line);
		padding: 8px 12px;
		text-align: left;
	}
	.prose-k :global(th) {
		color: var(--fg);
	}
	.prose-k :global(blockquote) {
		margin-left: 0;
		padding-left: 16px;
		border-left: 2px solid var(--acc);
		color: var(--mute);
	}
	.prose-k :global(hr) {
		border: none;
		border-top: 1px solid var(--line);
	}
	.prose-k :global(pre) {
		position: relative;
		margin: 1.6em 0;
		padding: 20px 20px 22px;
		padding-top: 52px;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--fg) 5%, var(--bg));
		overflow-x: auto;
		tab-size: 2;
		font-size: 13.5px;
		line-height: 1.7;
	}
	.prose-k :global(pre code) {
		padding: 0;
		border: none;
		background: none;
		text-decoration: none;
		font-size: inherit;
		line-height: inherit;
	}
	.prose-k :global(:not(pre) > code) {
		padding: 0.15em 0.4em;
		background: color-mix(in srgb, var(--fg) 7%, var(--bg));
		text-decoration: underline;
		text-decoration-color: var(--acc);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		font-size: 0.88em;
	}
	/* image enlarge affordance + lightbox overlay (markup built by lightbox.ts) */
	.prose-k :global(img) {
		cursor: zoom-in;
	}
	.cover img {
		cursor: zoom-in;
	}
	:global(.lightbox) {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		background: rgba(0, 0, 0, 0.9);
		cursor: zoom-out;
	}
	:global(.lightbox[hidden]) {
		display: none;
	}
	:global(.lightbox__img) {
		display: block;
		max-width: min(1200px, 94vw);
		max-height: 90svh;
		width: auto;
		height: auto;
		border: 1px solid var(--line);
		cursor: default;
	}
	:global(.lightbox__close) {
		position: absolute;
		top: 16px;
		right: 16px;
		padding: 10px 16px;
		border: none;
		background: var(--acc);
		color: #0b0b0b;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		cursor: pointer;
	}
	:global(.lightbox--anim) {
		animation: lightbox-in 0.18s ease-out;
	}
	@keyframes lightbox-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.lightbox--anim) {
			animation: none;
		}
	}
	.prose-k :global(.code-copy) {
		position: absolute;
		top: 10px;
		right: 10px;
		padding: 6px 12px;
		border: 1px solid var(--acc);
		background: var(--acc);
		color: #0b0b0b;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.prose-k :global(.code-copy:hover) {
		background: transparent;
		color: var(--acc);
	}
	.prose-k :global(.table-wrap) {
		overflow-x: auto;
		border: 1px solid var(--line);
	}
	.prose-k :global(.tni table) {
		display: table;
		overflow: visible;
		border-collapse: collapse;
		border-style: hidden;
	}
</style>
