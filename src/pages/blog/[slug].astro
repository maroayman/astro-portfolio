---
import KineticLayout from '../../layouts/KineticLayout.astro';
import Crumb from '../../components/Crumb.astro';
import { getPosts, formatDate, readingTime, tagSlug, postSlug, coverDims } from '../../utils/blog';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: postSlug(post) },
		props: {
			post,
			newer: i > 0 ? posts[i - 1] : null,
			older: i < posts.length - 1 ? posts[i + 1] : null,
		},
	}));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const mins = readingTime(post.body ?? '');
const dims = post.data.cover ? coverDims[post.data.cover] : undefined;
---

<KineticLayout title={post.data.title} description={post.data.description}>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: post.data.title,
			description: post.data.description,
			datePublished: post.data.date.toISOString(),
			author: { '@type': 'Person', name: 'Marwan Ayman Shawky' },
			url: new URL(`/blog/${postSlug(post)}/`, Astro.site ?? Astro.url.origin).href,
		})}
	/>
	<div class="body">
		<Crumb
			trail={[
				{ href: '/', label: 'Home' },
				{ href: '/blog/', label: 'Blog' },
				{ label: post.data.title },
			]}
		/>
		<h1 class="ptitle post-title">{post.data.title}</h1>
		<p class="kmeta">
			{formatDate(post.data.date)} · {mins} min read
		</p>
		<p class="intro">{post.data.description}</p>

		{post.data.tags.length > 0 && (
			<ul class="ktags" aria-label="Tags">
				{post.data.tags.map((tag) => (
					<li>
						<a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
					</li>
				))}
			</ul>
		)}

		{post.data.cover && (
			<figure class="cover">
				<img
					src={post.data.cover}
					alt=""
					width={dims?.width}
					height={dims?.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</figure>
		)}

		<!-- "prose" is the JS hook for code-copy/table-wrap (they query .prose);
		     visual styling comes from .prose-k in kinetic.css plus the extras below. -->
		<div class="prose-k prose">
			<Content />
		</div>

		<nav class="pagenav" aria-label="More posts">
			{older ? (
				<a href={`/blog/${postSlug(older)}/`}>
					← Older
					<strong>{older.data.title}</strong>
				</a>
			) : (
				<span />
			)}
			{newer ? (
				<a href={`/blog/${postSlug(newer)}/`}>
					Newer →<strong>{newer.data.title}</strong>
				</a>
			) : (
				<span />
			)}
		</nav>
		<p>
			<a class="back" href="/blog/">
				← Blog
			</a>
		</p>
	</div>
	<script>
		import '../../scripts/code-copy';
		import '../../scripts/table-wrap';
		import '../../scripts/lightbox';
		import '../../scripts/img-lazy';
	</script>
</KineticLayout>

<style>
	.post-title {
		font-size: clamp(2.2rem, 6vw, 4.5rem);
	}
	.ktags a {
		color: inherit;
		text-decoration: none;
	}
	.ktags a:hover,
	.ktags a:focus-visible {
		color: var(--fg);
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	/* Repo links — same convention as the Deno site: authors write
	   `[View on GitHub: user/repo](url)` and CSS renders the pill + brand
	   icon. Pure CSS, no JavaScript. */
	.prose-k :global(a[href*='github.com/']),
	.prose-k :global(a[href*='gitlab.com/']) {
		--repo-icon: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0.75rem 0;
		padding: 0.5rem 1rem;
		background-color: color-mix(in srgb, var(--fg) 6%, var(--bg));
		background-image: none;
		border: 1px solid var(--line);
		border-radius: 10px;
		color: var(--fg);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}
	.prose-k :global(a[href*='github.com/']:hover),
	.prose-k :global(a[href*='gitlab.com/']:hover),
	.prose-k :global(a[href*='github.com/']:focus-visible),
	.prose-k :global(a[href*='gitlab.com/']:focus-visible) {
		border-color: var(--acc);
		color: var(--fg);
		text-decoration: none;
	}
	.prose-k :global(a[href*='github.com/']::before),
	.prose-k :global(a[href*='gitlab.com/']::before) {
		content: '';
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		background: currentColor;
		mask-image: var(--repo-icon);
		mask-size: contain;
		mask-repeat: no-repeat;
		-webkit-mask-image: var(--repo-icon);
		-webkit-mask-size: contain;
		-webkit-mask-repeat: no-repeat;
	}
	.prose-k :global(a[href*='github.com/']) {
		--repo-icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.465-2.38 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.805 5.625-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'/%3E%3C/svg%3E");
	}
	.prose-k :global(a[href*='gitlab.com/']) {
		--repo-icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='m23.6004 9.5927-.0337-.0862L20.3.9814a.851.851 0 0 0-.3362-.405.8748.8748 0 0 0-.9997.0539.8748.8748 0 0 0-.29.4399l-2.2055 6.748H7.5375l-2.2057-6.748a.8573.8573 0 0 0-.29-.4412.8748.8748 0 0 0-.9997-.0537.8585.8585 0 0 0-.3362.4049L.4332 9.5015l-.0325.0862a6.0657 6.0657 0 0 0 2.0119 7.0105l.0113.0087.03.0213 4.976 3.7264 2.462 1.8633 1.4995 1.1321a1.0085 1.0085 0 0 0 1.2197 0l1.4995-1.1321 2.4619-1.8633 5.006-3.7489.0125-.01a6.0682 6.0682 0 0 0 2.0094-7.003z'/%3E%3C/svg%3E");
	}
	.cover {
		margin: 28px 0 0;
	}
	.cover img {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--line);
	}
	.prose-k :global(table) {
		display: block;
		width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}
	.prose-k :global(th),
	.prose-k :global(td) {
		border: 1px solid var(--line);
		padding: 8px 12px;
		text-align: left;
	}
	.prose-k :global(th) {
		color: var(--fg);
	}
	.prose-k :global(blockquote) {
		margin-left: 0;
		padding-left: 16px;
		border-left: 2px solid var(--acc);
		color: var(--mute);
	}
	.prose-k :global(hr) {
		border: none;
		border-top: 1px solid var(--line);
	}
	.prose-k :global(pre) {
		position: relative;
		margin: 1.6em 0;
		padding: 20px 20px 22px;
		padding-top: 52px;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--fg) 5%, var(--bg));
		overflow-x: auto;
		tab-size: 2;
		font-size: 13.5px;
		line-height: 1.7;
	}
	.prose-k :global(pre code) {
		padding: 0;
		border: none;
		background: none;
		text-decoration: none;
		font-size: inherit;
		line-height: inherit;
	}
	.prose-k :global(:not(pre) > code) {
		padding: 0.15em 0.4em;
		background: color-mix(in srgb, var(--fg) 7%, var(--bg));
		text-decoration: underline;
		text-decoration-color: var(--acc);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		font-size: 0.88em;
	}
	/* image enlarge affordance + lightbox overlay (markup built by lightbox.ts) */
	.prose-k :global(img) {
		cursor: zoom-in;
	}
	.cover img {
		cursor: zoom-in;
	}
	:global(.lightbox) {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		background: rgba(0, 0, 0, 0.9);
		cursor: zoom-out;
	}
	:global(.lightbox[hidden]) {
		display: none;
	}
	:global(.lightbox__img) {
		display: block;
		max-width: min(1200px, 94vw);
		max-height: 90svh;
		width: auto;
		height: auto;
		border: 1px solid var(--line);
		cursor: default;
	}
	:global(.lightbox__close) {
		position: absolute;
		top: 16px;
		right: 16px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 10px 16px;
		border: none;
		background: var(--acc);
		color: var(--on-acc);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		cursor: pointer;
	}
	:global(.lightbox--anim) {
		animation: lightbox-in 0.18s ease-out;
	}
	@keyframes lightbox-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.lightbox--anim) {
			animation: none;
		}
	}
	.prose-k :global(.code-copy) {
		position: absolute;
		top: 10px;
		right: 10px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 6px 12px;
		border: 1px solid var(--acc);
		background: var(--acc);
		color: var(--on-acc);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.prose-k :global(.code-copy:hover),
	.prose-k :global(.code-copy:focus-visible) {
		background: transparent;
		color: var(--acc);
	}
	.prose-k :global(.table-wrap) {
		overflow-x: auto;
		border: 1px solid var(--line);
	}
	.prose-k :global(.tni table) {
		display: table;
		overflow: visible;
		border-collapse: collapse;
		border-style: hidden;
	}
</style>
