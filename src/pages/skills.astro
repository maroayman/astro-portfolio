---
import TilesLayout from '../layouts/TilesLayout.astro';
import Ticker from '../components/Ticker.astro';
import Section from '../components/Section.astro';
import SkillTable from '../components/SkillTable.astro';
import CertList from '../components/CertList.astro';
import Cta from '../components/Cta.astro';
import { skills } from '../data/portfolio';

const uniq = (items: string[]) => [...new Set(items)];

const marquee = [
	'Containers',
	'Orchestration',
	'IaC',
	'CI/CD',
	'Observability',
	'Security',
	'Networking',
	'Platform',
];
---

<TilesLayout
	windowId="skills"
	title="Stack"
	description="Tools and technologies Marwan Ayman Shawky uses as a Cloud & DevOps Engineer: Kubernetes, Terraform, AWS, GCP, CI/CD, and GitOps."
	file="skills.md"
	docTitle="Stack & tooling"
	intro="Grouped by what I actually use them for — not by how good they look on a slide. Most of it runs in production right now."
	entries={skills.map((group) => ({
		text: `${group.title} — ${group.items.length} tools`,
	}))}
	tags={uniq(skills.flatMap((group) => group.items))}
>
	<Ticker items={marquee} />

	<Section
		divided={false}
		title="Everything in the toolbox"
		sub="If it's listed here, I've run it in production and debugged it when it broke."
	>
		<SkillTable />
	</Section>

	<Section
		index="02"
		label="Credentials"
		title="Certifications"
		sub="Formal proof I can operate under pressure, on paper at least."
	>
		<CertList />
	</Section>

	<Section>
		<Cta>
			<span slot="title">Want the whole picture?</span>
			<span slot="sub">Every tool here is one I've debugged at 3am. Ask me about any of them.</span>
		</Cta>
	</Section>
</TilesLayout>
