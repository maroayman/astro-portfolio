---
import '../styles/fonts.css';
import '../styles/global.css';
import { profile } from '../data/portfolio';

/** Faces needed for the first paint — preloaded, everything else loads on demand. */
const PRELOAD_FONTS = ['/fonts/inter-800.woff2', '/fonts/inter-400.woff2'];

interface Props {
	title?: string;
	description?: string;
}

const base = 'Marwan Ayman Shawky — Cloud & DevOps Engineer';
const {
	title = base,
	description = 'Portfolio of Marwan Ayman Shawky, a Cloud & DevOps Engineer working with Kubernetes, Terraform, CI/CD, and GitOps on AWS and on-premises.',
} = Astro.props;

const fullTitle = title === base ? title : `${title} — ${base}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content={profile.name} />
		{
			/*
				Preload only what paints first paint: Inter 800 (giant display
				headlines) and Inter 400 (body). The remaining faces load lazily.
			*/
			PRELOAD_FONTS.map((href) => (
				<link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
			))
		}
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" content="#0f0d0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
		<link rel="canonical" href={canonical} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${profile.name} — Blog`}
			href="/rss.xml"
		/>
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={profile.name} />
		<meta name="twitter:card" content="summary" />
		<title>{fullTitle}</title>
		<script is:inline>
			// Runs before paint so the page never flashes the wrong theme,
			// and flags that scripting is available (reveal animations are
			// scoped to .js so content stays visible without it).
			document.documentElement.classList.add('js');
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {
					/* private mode / storage blocked — fall back to the OS setting */
				}
				const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
				document.documentElement.dataset.theme = stored ?? (prefersLight ? 'light' : 'dark');
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<div class="blueprint" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
		<div id="top"></div>
		<slot />
		<script>
			import '../scripts/reveal';
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: 16px;
		top: -60px;
		z-index: 100;
		padding: 10px 16px;
		background: var(--accent);
		color: var(--accent-contrast);
		border-radius: var(--r);
		font-family: var(--font-mono);
		font-size: 13px;
		transition: top 0.2s ease;
	}
	.skip-link:focus {
		top: 16px;
	}
</style>
