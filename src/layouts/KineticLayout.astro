---
import '../styles/kinetic.css';
import { profile } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
  /** href of the active nav item, e.g. "/experience" — omit on homepage */
  active?: string;
}

const base = 'Marwan Ayman Shawky – Cloud & DevOps Engineer';
const {
  title = base,
  description = 'Marwan Ayman Shawky is a Cloud and DevOps engineer in Cairo, Egypt, focused on infrastructure automation, GitOps, and reliable systems.',
  active,
} = Astro.props;

const fullTitle = title === base ? title : `${title} – ${base}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — Blog`}
      href="/rss.xml"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Roboto+Flex:wdth,wght@25..151,100..1000&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Roboto+Flex:wdth,wght@25..151,100..1000&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Roboto+Flex:wdth,wght@25..151,100..1000&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main class="page" id="main">
      <header class="top">
        <span class="clock" id="clock">Cairo, Egypt</span>
        <ul class="soc" aria-label="Social">
          <li>
            <a href={profile.links.github} aria-label="GitHub">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.216.694.825.576C20.565 21.796 24 17.3 24 12.297c0-6.627-5.373-12-12-12" /></svg>
            </a>
          </li>
          <li>
            <a href={profile.links.gitlab} aria-label="GitLab">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.6 9.59l-.03-.09L20.3.98a.85.85 0 0 0-.34-.4.88.88 0 0 0-1 .05.88.88 0 0 0-.29.44l-2.2 6.75H7.54L5.33 1.07a.86.86 0 0 0-.29-.44.88.88 0 0 0-1-.05.86.86 0 0 0-.34.4L.43 9.5l-.03.09a6.07 6.07 0 0 0 2.01 7.01l.01.01.03.02 4.98 3.73 2.46 1.86 1.5 1.13a1 1 0 0 0 1.22 0l1.5-1.13 2.46-1.86 5-3.75.01-.01a6.07 6.07 0 0 0 2.01-7z" /></svg>
            </a>
          </li>
          <li>
            <a href={profile.links.linkedin} aria-label="LinkedIn">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
            </a>
          </li>
          <li>
            <a href={profile.links.linktree} aria-label="Linktree">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m13.73635 5.85251 4.00467-4.11665 2.3248 2.3808-4.20064 4.00466h5.9085v3.30473h-5.9365l4.22865 4.10766-2.3248 2.3338L12.0005 12.099l-5.74052 5.76852-2.3248-2.3248 4.22864-4.10766h-5.9375V8.12132h5.9085L3.93417 4.11666l2.3248-2.3808 4.00468 4.11665V0h3.4727zm-3.4727 10.30614h3.4727V24h-3.4727z" /></svg>
            </a>
          </li>
        </ul>
      </header>

      <slot />

      <footer class="foot">
        <div class="mailrow">
          <a id="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="copy" id="copy" type="button" aria-label="Copy email address">Copy</button>
        </div>
        <a class="copy resume-foot" href="/resume.pdf" aria-label="Open my resume as PDF">Resume</a>
      </footer>
    </main>

    <script define:vars={{ active }}>
      const $ = (id) => document.getElementById(id);

      // Email: mailto + Copy follow the #mail link
      const mail = $('mail');
      if (mail) {
        const address = () => mail.textContent.trim();
        mail.href = 'mailto:' + address();
        const btn = $('copy');
        let t;
        btn?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(address());
          } catch (e) {
            const r = document.createRange();
            r.selectNodeContents(mail);
            const s = getSelection();
            s.removeAllRanges();
            s.addRange(r);
            return;
          }
          btn.classList.add('done');
          btn.textContent = 'Copied';
          btn.setAttribute('aria-label', 'Email address copied');
          clearTimeout(t);
          t = setTimeout(() => {
            btn.classList.remove('done');
            btn.textContent = 'Copy';
            btn.setAttribute('aria-label', 'Copy email address');
          }, 1800);
        });
      }

      // Peek line (homepage only)
      const peek = $('peek');
      const links = [...document.querySelectorAll('.nav a')];
      if (peek && links.length) {
        const def = peek.textContent;
        const show = (a) => { peek.textContent = a.dataset.peek; };
        links.forEach((a) => {
          a.addEventListener('mouseenter', () => show(a));
          a.addEventListener('focus', () => show(a));
        });
        document.querySelector('.nav')?.addEventListener('mouseleave', () => { peek.textContent = def; });
      }

      // Kinetic name: width follows pointer x, weight follows pointer y
      const name = $('name') ?? document.querySelector('.ptitle');
      const reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
      const fine = matchMedia('(pointer:fine)').matches;
      if (name && !reduce && fine) {
        let tx = 0.5, ty = 0.5, cx = 0.5, cy = 0.5;
        addEventListener('pointermove', (e) => {
          tx = e.clientX / innerWidth;
          ty = e.clientY / innerHeight;
        });
        const frame = () => {
          cx += (tx - cx) * 0.07;
          cy += (ty - cy) * 0.07;
          name.style.setProperty('--wd', (75 + cx * 76).toFixed(1));
          name.style.setProperty('--wg', Math.round(200 + (1 - cy) * 700));
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }

      // Cairo clock
      try {
        const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit' });
        const tick = () => { const el = $('clock'); if (el) el.textContent = fmt.format(new Date()) + ' in Cairo, Egypt'; };
        tick();
        setInterval(tick, 30000);
      } catch {}

      // Shortcuts E/P/C/B/U
      addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || e.repeat) return;
        if (/^(input|textarea|select)$/i.test(e.target.tagName) || e.target.isContentEditable) return;
        const a = links.find((x) => x.dataset.key === e.key.toLowerCase());
        if (a) location.href = a.href;
      });
    </script>
  </body>
</html>
